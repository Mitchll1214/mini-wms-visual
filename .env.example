# ============================================================
# MiniWMS Visual - 构建部署环境配置（国内外兼容）
# 复制为 .env 使用：cp .env.example .env
# 默认值面向国内服务器（直接 docker compose up 即可）。
# 部署到国外服务器时，将下面 NPM_REGISTRY / MAVEN_MIRROR 切换为官方源。
# ============================================================

# 对外服务端口（默认 3030，映射容器内 8080）
PORT=3030

# 基础镜像仓库前缀：默认留空 = Docker Hub 官方镜像
# 国内加速示例（任选其一）：
#   REGISTRY_PREFIX=m.daocloud.io/docker.io/
#   REGISTRY_PREFIX=registry.cn-hangzhou.aliyuncs.com/
REGISTRY_PREFIX=

# npm 依赖源（国内默认 npmmirror）
NPM_REGISTRY=https://registry.npmmirror.com

# Maven 中央仓库镜像（国内默认阿里云）
MAVEN_MIRROR=https://maven.aliyun.com/repository/public

# ---------- 国外服务器推荐配置（取消注释使用） ----------
# REGISTRY_PREFIX=
# NPM_REGISTRY=https://registry.npmjs.org
# MAVEN_MIRROR=https://repo.maven.apache.org/maven2