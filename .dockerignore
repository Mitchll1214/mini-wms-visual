# MiniWMS Visual Docker Ignore
# 将不必要的文件排除在构建上下文之外

# Git
.git
.gitattributes

# IDE
.idea
.vscode
*.iml

# Maven 目标目录
mini-wms-backend/target

# Node.js 依赖和构建产物（已在 Docker 内重新安装构建）
mini-wms-frontend/node_modules
mini-wms-frontend/dist
mini-wms-frontend/.vite

# 日志文件
logs
*.log

# 临时文件
*.tmp
*.swp
*~

# 测试文件（Docker 构建时 skipTests）
mini-wms-backend/src/test

# 文档和许可证（可选，减小镜像体积）
README.md
LICENSE
*.md

# 压缩包
*.zip
*.tar.gz
*.tar
*.jar

# 操作系统文件
.DS_Store
Thumbs.db
